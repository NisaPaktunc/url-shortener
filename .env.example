# Copy this file to .env and fill in the values.
# Never commit your real .env file (it is already in .gitignore).

# Database. SQLite for development. For Postgres, for example:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/shortener
# (docker compose sets this value itself, you do not need it there.)
DATABASE_URL=sqlite:///./shortener.db

# Only used by docker compose: the password of the Postgres database.
# Use letters and digits only (for example from `openssl rand -hex 24`),
# because it becomes a part of the database URL.
POSTGRES_PASSWORD=

# Secret used to sign login tokens (JWT). Required, at least 32 characters.
# Keep it private. If it leaks, anyone can make valid tokens.
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# How long a login token is valid, in minutes.
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Log level: DEBUG, INFO, WARNING, ERROR or CRITICAL.
LOG_LEVEL=INFO

# Rate limits per client IP address. Set RATE_LIMIT_ENABLED=false to turn
# them off (for example while you test with a script).
RATE_LIMIT_ENABLED=true
LOGIN_RATE_LIMIT=5/minute
CREATE_LINK_RATE_LIMIT=30/minute

# Only needed behind a reverse proxy (Render sets it for you). The proxy's
# X-Forwarded-Proto and X-Forwarded-For headers are trusted from these
# addresses. Do not set "*" when the app is reachable without a proxy,
# because anyone could then fake their address.
# FORWARDED_ALLOW_IPS=*

# Number of reverse proxies in front of the app (0 = none, the default).
# Rate limits use it to find the client address in X-Forwarded-For.
# TRUSTED_PROXY_HOPS=0
